# ===== Bot de Liquidez v2 (mejorado para mayor winrate) =====
TELEGRAM_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
TIMEFRAMES=5m,15m
CANDLES=500
MIN_VOLUME_USDT=1500000
CONCURRENCY=8
MARKET_TYPE=swap
EXCLUDE_NON_CRYPTO=true

# Zonas de liquidez (más selectivas)
LQ_PIVOT=5
LQ_LOOKBACK=300
LQ_TOL_ATR=0.22
LQ_EXTREME_N=20
LQ_MIN_ZONE_SCORE=58
LQ_PREFER_EXTERNAL=true

# Liquidaciones estimadas
LQ_LEVERAGES=10,25,50,100
LQ_LEV_WEIGHTS=0.25,0.30,0.30,0.15
LQ_LONG_SHARE=0.6
LQ_LIQ_RANGE_PCT=8

# Setups y fuerza (más estricto)
LQ_ENABLE_SOUP=true
LQ_ENABLE_PLUS1=true
LQ_ENABLE_BOUNCE=true
LQ_MIN_SWEEP_ATR=0.08
LQ_MAX_SWEEP_ATR=1.8
LQ_VOL_MULT=1.7
LQ_MIN_WICK=0.42
LQ_MIN_QUALITY=72
LQ_USE_EMA_FILTER=true
LQ_MIN_CLOSE_LOC=0.55
LQ_BOUNCE_MIN_ZONE=70

# Gestión de riesgo (mejorada)
LQ_SL_ATR_BUFFER=0.12
LQ_MIN_RR=1.6
LQ_DEFAULT_RR=2.2
LQ_MAX_RR=3.5
LQ_MIN_TP_ZONE_SCORE=48
LQ_MAX_RISK_PCT=2.5
LQ_MAX_HOLD_BARS=36
LQ_COOLDOWN_BARS=8
LQ_TRAIL_BE=true
LQ_TRAIL_BE_BUFFER=0.05

# Filtros extra
LQ_MAX_ATR_SPIKE=2.8
LQ_ZONE_COOLDOWN=true

# Resumen diario
REPORT_TZ=Europe/Madrid
REPORT_TIME=23:59
FEE_PCT_ROUNDTRIP=0.1

# Extras del indicador de TradingView
LQ_USE_UT=true
UT_ATR_PERIOD=10
UT_MULT=2
LQ_UT_REQUIRE=false
LQ_USE_LINREG=true
LINREG_LEN=11
LINREG_SIGNAL=7
LQ_USE_SR=true
LQ_USE_HTF=true
LQ_HTF_MIN_ALIGNED=1
LQ_SHOW_PANEL=true
